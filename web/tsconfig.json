{
  "include": ["src", "scripts", "vite.config.ts"],
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "lib": ["esnext", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "bun"],
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "moduleDetection": "force",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
